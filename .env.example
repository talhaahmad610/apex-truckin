# Copy to .env.local for local development: `cp .env.example .env.local`
# The DATABASE_URI / S3_* values below match docker-compose.yml's LOCAL THROWAWAY credentials.
# Every secret must be replaced with a real, unique value in production.

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── Payload CMS ──────────────────────────────────────────
# Signs admin sessions/API tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=replace_with_openssl_rand_hex_32

# ── PostgreSQL (docker compose service "postgres") ──────
DATABASE_URI=postgres://apex:apex_dev_password@127.0.0.1:5432/apex_truckin

# ── MinIO / S3-compatible storage (docker compose service "minio") ──
S3_ENDPOINT=http://127.0.0.1:9000
# Public base URL browsers load files from (prod: e.g. https://media.apextruckin.com)
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_BUCKET=apex-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=apex_minio
S3_SECRET_ACCESS_KEY=apex_minio_dev_password

# ── Email via Resend — REQUIRED on a server (lead alerts, visitor auto-reply, password resets) ──
# Optional locally: without a key, emails are only logged to the console. Get the key from resend.com
# after verifying your sending domain; EMAIL_FROM must be an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=dispatch@apextruckin.com

# ── Hero footage processing (optional) ──────────────────
# Directory containing ffmpeg/ffprobe, if not already on PATH.
FFMPEG_BIN=
# Only needed if the running server can't reach its own public URL from inside the container
# (e.g. behind a reverse proxy in production) — the hero-video job uses this to call back into
# the site's /api/revalidate route. Leave blank locally.
INTERNAL_SITE_URL=

# ── First admin account, created by `npm run seed` if no users exist ──
SEED_ADMIN_EMAIL=admin@apextruckin.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password

# ── Legacy blog write API (x-api-key header) — kept as a transitional fallback ──
BLOG_API_KEY=replace_with_openssl_rand_hex_32
