# ── Supabase ─────────────────────────────────────────────
# Project Settings → API. Without these the site runs on built-in seed data.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Used by the CMS write API (POST/PUT/DELETE /api/posts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Blog CMS API ─────────────────────────────────────────
# Send as the `x-api-key` header for write requests. Generate with: openssl rand -hex 32
BLOG_API_KEY=your_secret_key_for_cms_api

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://apextruckin.com
