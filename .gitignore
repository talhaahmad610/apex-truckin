# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
!.env.docker.example

# raw source media (processed output lives in public/) — credits files are still tracked
/assets/raw/
/assets/raw-images/

# local security-scan output (npm audit, semgrep, ZAP, nuclei) — never commit, not needed to deploy
/tool-results/

# original build brief for the retired Supabase version — local reference only, not needed to deploy
/apex_truckin_claude_prompt.md
