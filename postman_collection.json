{
  "info": {
    "name": "Apex Truckin API",
    "description": "Apex Truckin APIs. Site routes live under /api/*; the Payload CMS REST API lives under /cms-api/*.\n\nAuth for writes: either the legacy `x-api-key` header ({{apiKey}} = BLOG_API_KEY) or a Payload user API key (`Authorization: users API-Key {{userApiKey}}`, enabled per user in /admin → Users → Enable API Key). The CMS folder can also log in and use a JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3200"
    },
    {
      "key": "apiKey",
      "value": "your_BLOG_API_KEY"
    },
    {
      "key": "userApiKey",
      "value": "your_payload_user_api_key"
    },
    {
      "key": "adminEmail",
      "value": "admin@apextruckin.com"
    },
    {
      "key": "adminPassword",
      "value": "your_admin_password"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "slug",
      "value": "best-paying-loads-owner-operator-2025"
    }
  ],
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts?limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);"
                ]
              }
            }
          ]
        },
