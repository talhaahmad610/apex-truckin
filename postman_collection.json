    {
      "name": "CMS (Payload REST)",
      "description": "Payload CMS REST API. Collections: posts, categories, media, leads, subscribers, users. Leads/subscribers/users are admin-only (403 without auth). Anonymous readers only see published posts.",
      "item": [
        {
          "name": "Login (saves JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cms-api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms-api",
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set(\"jwt\", j.token);",
                  "pm.test(\"logged in\", () => pm.expect(j.token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "JWT {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cms-api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms-api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Published posts (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cms-api/posts?where[_status][equals]=published&limit=10&depth=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms-api",
                "posts"
              ],
              "query": [
                {
                  "key": "where[_status][equals]",
                  "value": "published"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "depth",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "All posts incl. drafts (admin)",
