        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hours of Service Rules Every Owner-Operator Should Know\",\n  \"slug\": \"hours-of-service-rules\",\n  \"excerpt\": \"A plain-English guide to the FMCSA 11-hour, 14-hour and 70-hour rules.\",\n  \"content\": \"<p>The FMCSA hours-of-service rules limit driving time to keep roads safe.</p><h2>The 11-hour driving limit</h2><p>You may drive up to 11 hours after 10 consecutive hours off duty.</p><h2>The 14-hour window</h2><p>Once you come on duty you have a 14-hour window to complete your driving.</p>\",\n  \"cover_image_url\": \"/images/blog-best-loads.webp\",\n  \"category\": \"Regulations\",\n  \"author\": \"Apex Truckin Team\",\n  \"meta_description\": \"Learn the FMCSA hours-of-service rules: 11-hour driving limit, 14-hour window, 30-minute break and the 60/70-hour limit.\",\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);"
                ]
              }
            }
          ]
        },
