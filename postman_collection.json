        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "JWT {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cms-api/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms-api",
                "media"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
