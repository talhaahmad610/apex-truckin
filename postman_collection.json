            ],
            "url": {
              "raw": "{{baseUrl}}/cms-api/posts?draft=true&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cms-api",
                "posts"
              ],
              "query": [
                {
                  "key": "draft",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
