{
  "info": {
    "name": "Apex Truckin API",
    "description": "Blog CMS + forms API for Apex Truckin. Set `baseUrl` (default http://localhost:3000) and `apiKey` (= BLOG_API_KEY) in the collection variables.\n\nWrite endpoints require the `x-api-key` header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "your_secret_key_for_cms_api"
    },
    {
      "key": "slug",
      "value": "best-paying-loads-owner-operator-2025"
    }
  ],
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts?limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);"
                ]
              }
            }
          ]
        },
        {
          "name": "List posts by category",
          "request": {
            "method": "GET",
