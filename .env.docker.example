# Copy to .env.docker for running the app in Docker: `cp .env.docker.example .env.docker`
# These are the values that differ between machines (local Docker vs. a real server) — every
# `docker compose` call for the app/tools services goes through `scripts/compose.sh` (or the
# npm run docker:* scripts), which always passes `--env-file .env.docker` alongside
# `env_file: [.env.local, .env.docker]` on those services, so this file both fills in compose's
# `${...}` substitutions (build args, the Postgres password) and becomes real container env vars.
# `.env.local` still holds the secrets that don't change per machine (PAYLOAD_SECRET, Resend,
# BLOG_API_KEY, SEED_ADMIN_*) and is loaded first, so this file only needs to override what's
# actually different here.

# ── Site ─────────────────────────────────────────────────
# The public URL this deployment is reached at. Also baked into the built image (build arg) —
# rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── PostgreSQL — the `postgres` compose service, same on every machine ──
POSTGRES_PASSWORD=apex_dev_password
DATABASE_URI=postgres://apex:apex_dev_password@postgres:5432/apex_truckin

# ── S3-compatible storage ────────────────────────────────
# LOCAL DEFAULT (this repo's own MinIO, via `npm run infra:up --profile minio` / `docker:up`):
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://media.localhost:9000
S3_BUCKET=apex-media
S3_ACCESS_KEY_ID=apex_minio
S3_SECRET_ACCESS_KEY=apex_minio_dev_password
S3_REGION=us-east-1
#
# SERVER: replace all five S3_* values above with the lead dev's own S3-compatible endpoint —
# this app never starts or depends on our compose `minio` service in that case. S3_PUBLIC_URL is
# also a build arg (baked into next.config.ts's image allowlist) — rebuild after changing it.

# ── Hero footage processing ──────────────────────────────
# Cleared here on purpose: ffmpeg/ffprobe are baked into the app image (see Dockerfile) and always
# resolve via PATH — never install ffmpeg on the server itself.
FFMPEG_BIN=

# Only needed if the app container can't reach its own public URL from inside the network (e.g.
# behind a reverse proxy) — the hero-video job calls back into /api/revalidate after each clip
# finishes. Usually unnecessary: the app talks to itself over the container's own loopback.
INTERNAL_SITE_URL=http://127.0.0.1:3000
